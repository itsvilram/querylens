# Copy this file to api/.env and fill in your own values.
# api/.env is git-ignored: never commit it, never paste keys into chats or issues.

# "fake" = scripted demo answers, no network, no key needed. "real" = call the LLM.
LLM_MODE=fake

# Gemini API key from https://aistudio.google.com (the free tier is enough).
GEMINI_API_KEY=

# Optional: Groq key from https://console.groq.com (only for the comparison run).
GROQ_API_KEY=

# Optional overrides (the defaults are shown).
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.5-flash-lite
# LLM_REASONING_EFFORT=low
# LLM_STRUCTURED_OUTPUT=true
# DAILY_TOKEN_BUDGET=1000000
# ROW_CAP=1000
# QUERY_TIMEOUT_MS=5000

# Connections. The defaults match docker-compose.yml, so you only need these
# outside local development.
# READONLY_DATABASE_URL=postgresql://ro_user:ro_user_dev@127.0.0.1:5432/pagila
# REDIS_URL=redis://127.0.0.1:6379/0
