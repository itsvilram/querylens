# Copy this file to api/.env and fill in your own values.
# api/.env is git-ignored: never commit it, never paste keys into chats or issues.

# "fake" = scripted answers, no network, no key needed. "real" = call Gemini.
LLM_MODE=fake

# Gemini API key from https://aistudio.google.com (free tier is enough).
GEMINI_API_KEY=

# Optional: Groq key from https://console.groq.com (only for the comparison run).
GROQ_API_KEY=

# Connection for generated SQL (the read-only role). The default matches
# docker-compose.yml, so you only need this outside local development.
# READONLY_DATABASE_URL=postgresql://ro_user:ro_user_dev@127.0.0.1:5432/pagila
